diff --git a/src/components/ui/Progress/Progress.tsx b/src/components/ui/Progress/Progress.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/ui/Progress/Progress.tsx
@@ -0,0 +1,18 @@
+type Props = { value: number; max?: number }
+
+export default function Progress({ value, max = 100 }: Props) {
+  const v = Math.max(0, Math.min(value, max))
+  const percent = (v / max) * 100
+  return (
+    <div role="progressbar" aria-valuenow={v} aria-valuemin={0} aria-valuemax={max} className="h-2 bg-gray-200 rounded">
+      <div style={{ width: `${percent}%` }} className="h-2 rounded bg-blue-600" />
+    </div>
+  )
+}
