+type Props = {
+  text: string
+  color?: string
+  onRemove?: () => void
+}
+
+export default function Tag({ text, color = 'bg-gray-200 text-gray-800', onRemove }: Props) {
+  return (
+    <span className={`inline-flex items-center gap-2 px-2 py-0.5 rounded ${color}`}>
+      {text}
+      {onRemove && (
+        <button aria-label="remove tag" onClick={() => onRemove?.()}>
+          ×
+        </button>
+      )}
+    </span>
+  )
+}
