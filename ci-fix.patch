diff --git a/src/components/ui/ModalForm/ModalForm.tsx b/src/components/ui/ModalForm/ModalForm.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/ui/ModalForm/ModalForm.tsx
@@ -0,0 +1,33 @@
+import type { ReactNode } from 'react'
+
+type Props = {
+  open: boolean
+  title: string
+  onClose: () => void
+  onSubmit: () => Promise<void>
+  children?: ReactNode
+}
+
+export default function ModalForm({ open, title, onClose, onSubmit, children }: Props) {
+  if (!open) return null
+  return (
+    <div role="dialog" aria-modal="true" className="fixed inset-0 grid place-items-center bg-black/40">
+      <div className="bg-white rounded p-4 w-[420px]">
+        <h2 className="text-lg font-semibold mb-3">{title}</h2>
+        <div className="mb-4">{children}</div>
+        <div className="flex justify-end gap-2">
+          <button onClick={() => onClose()} className="border rounded px-3 py-1">
+            取消
+          </button>
+          <button onClick={() => void onSubmit()} className="rounded px-3 py-1 bg-blue-600 text-white">
+            确定
+          </button>
+        </div>
+      </div>
+    </div>
+  )
+}
