{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "types": ["react", "react-dom", "node"] // ⬅️ 去掉 vite/vitest
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".storybook", // 如不想让 Storybook 参与 Next 检查可删除这一行
    "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".next/types" // ✅ 避免污染
  ]
}
